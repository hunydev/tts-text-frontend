{
  "controls": [
    {
      "group": "발음 직접 지정",
      "rows": [
        {
          "syntax": "원자{발음}",
          "meaning": "바로 앞 단어·숫자 하나를 적은 발음으로 바꿈",
          "example": "1{첫}번째",
          "output": "첫번째"
        },
        {
          "syntax": "원자{발음}",
          "meaning": "영문·숫자 코드의 발음 지정",
          "example": "K7{케이세븐}",
          "output": "케이세븐"
        },
        {
          "syntax": "[[구간]]{발음}",
          "meaning": "공백이 있는 여러 단어를 묶어 발음 지정",
          "example": "[[Bank of America]]{뱅크 오브 아메리카}",
          "output": "뱅크 오브 아메리카"
        }
      ]
    },
    {
      "group": "읽기 방식 지정 (값 하나)",
      "rows": [
        {
          "syntax": "숫자{@native}",
          "meaning": "고유어 수 (0~99)",
          "example": "21{@native}",
          "output": "스물하나"
        },
        {
          "syntax": "숫자{@sino}",
          "meaning": "한자어 수",
          "example": "-12{@sino}",
          "output": "마이너스 십이"
        },
        {
          "syntax": "문자{@alphabet}",
          "meaning": "영문자·숫자를 한 글자씩",
          "example": "ABC{@alphabet}마트",
          "output": "에이비씨마트"
        }
      ]
    },
    {
      "group": "의미 지정 (구간 전체)",
      "rows": [
        {
          "syntax": "[[…]]{@cardinal}",
          "meaning": "일반 수량 (정수)",
          "example": "[[09]]{@cardinal}",
          "output": "구"
        },
        {
          "syntax": "[[…]]{@digits}",
          "meaning": "모든 자릿수를 하나씩 (선행 0 포함)",
          "example": "[[0210]]{@digits}",
          "output": "공이일공"
        },
        {
          "syntax": "[[…]]{@decimal}",
          "meaning": "소수 (소수부 0 유지)",
          "example": "[[12.50]]{@decimal}",
          "output": "십이 점 오영"
        },
        {
          "syntax": "[[…]]{@ordinal}",
          "meaning": "서수",
          "example": "[[21]]{@ordinal}",
          "output": "제이십일"
        },
        {
          "syntax": "[[…]]{@year}",
          "meaning": "연도",
          "example": "[[1984]]{@year}",
          "output": "천구백팔십사 년"
        },
        {
          "syntax": "[[…]]{@date}",
          "meaning": "날짜 (YYYY-MM-DD)",
          "example": "[[2026-09-16]]{@date}",
          "output": "이천이십육 년 구 월 십육 일"
        },
        {
          "syntax": "[[…]]{@date-mdy}",
          "meaning": "월/일/연 순서의 날짜",
          "example": "[[03/04/2026]]{@date-mdy}",
          "output": "이천이십육 년 삼 월 사 일"
        },
        {
          "syntax": "[[…]]{@date-dmy}",
          "meaning": "일/월/연 순서의 날짜",
          "example": "[[03/04/2026]]{@date-dmy}",
          "output": "이천이십육 년 사 월 삼 일"
        },
        {
          "syntax": "[[…]]{@time}",
          "meaning": "시각",
          "example": "[[09:05]]{@time}",
          "output": "아홉 시 오 분"
        },
        {
          "syntax": "[[…]]{@currency}",
          "meaning": "금액",
          "example": "[[12,500원]]{@currency}",
          "output": "만 이천오백 원"
        },
        {
          "syntax": "[[…]]{@percent}",
          "meaning": "퍼센트",
          "example": "[[12.5%]]{@percent}",
          "output": "십이 점 오 퍼센트"
        },
        {
          "syntax": "[[…]]{@measure}",
          "meaning": "수 + 단위",
          "example": "[[3kg]]{@measure}",
          "output": "삼 킬로그램"
        },
        {
          "syntax": "[[…]]{@counter}",
          "meaning": "수 + 셈 단위 (한국어)",
          "example": "[[3개]]{@counter}",
          "output": "세 개"
        },
        {
          "syntax": "[[…]]{@fraction}",
          "meaning": "분수",
          "example": "[[9/25]]{@fraction}",
          "output": "이십오 분의 구"
        },
        {
          "syntax": "[[…]]{@range}",
          "meaning": "범위",
          "example": "[[1~2kg]]{@range}",
          "output": "일에서 이 킬로그램"
        },
        {
          "syntax": "[[…]]{@score}",
          "meaning": "점수·대비 (하이픈이나 콜론으로 이은 두 수, 대로 읽기)",
          "example": "10:10{@score}",
          "output": "십 대 십"
        },
        {
          "syntax": "[[…]]{@digits:N}",
          "meaning": "N자리씩 끊어 읽기 (여러 숫자는 차례로 되풀이: 344는 3·4·4)",
          "example": "123123{@digits:12}",
          "output": "일 이삼 일 이삼"
        },
        {
          "syntax": "[[…]]{@unit}",
          "meaning": "숫자+영문 단위 (사전 용어보다 단위로, 대소문자 무관: 3M 삼 미터)",
          "example": "3M{@unit}",
          "output": "삼 미터"
        },
        {
          "syntax": "[[…]]{@math}",
          "meaning": "수식 (하이픈은 빼기, 연산자 말은 math_operator 리소스)",
          "example": "4-3{@math}",
          "output": "사 빼기 삼"
        },
        {
          "syntax": "[[…]]{@phone}",
          "meaning": "전화번호",
          "example": "[[0210-09]]{@phone}",
          "output": "공이일공 공구"
        },
        {
          "syntax": "[[…]]{@version}",
          "meaning": "버전 번호",
          "example": "[[12.03.4]]{@version}",
          "output": "십이 점 영삼 점 사"
        },
        {
          "syntax": "[[…]]{@ip}",
          "meaning": "IP 주소",
          "example": "[[192.168.0.1]]{@ip}",
          "output": "일구이 점 일육팔 점 공 점 일"
        },
        {
          "syntax": "[[…]]{@address}",
          "meaning": "주소 (숫자 사이 하이픈은 '다시')",
          "example": "[[서울시 12-3]]{@address}",
          "output": "서울시 십이 다시 삼"
        },
        {
          "syntax": "[[…]]{@email}",
          "meaning": "이메일 (표기 보존 모드에서도 읽음)",
          "example": "[[a1@b2.com]]{@email}",
          "output": "에이일 앳 비이 닷 컴"
        },
        {
          "syntax": "[[…]]{@url}",
          "meaning": "URL·경로",
          "example": "[[q1/a2]]{@url}",
          "output": "큐일 슬래시 에이이"
        }
      ]
    },
    {
      "group": "구간 처리",
      "rows": [
        {
          "syntax": "[[…]]{@preserve}",
          "meaning": "구간을 정규화하지 않고 그대로 둠",
          "example": "[[Apple 123 🙂]]{@preserve}",
          "output": "Apple 123 🙂"
        },
        {
          "syntax": "[[…]]{@skip}",
          "meaning": "구간을 읽지 않고 삭제 (공백은 건드리지 않음)",
          "example": "가[[녹음 지시]]{@skip}나",
          "output": "가나"
        }
      ]
    },
    {
      "group": "구간 사전",
      "rows": [
        {
          "syntax": "[[…]]{@dictionary:이름}",
          "meaning": "구간만 이름 있는 사전으로 읽음 (이름.tsv도 됨, 요청 사전 자리를 대신함)",
          "example": "[[TV]]{@dictionary:brand} 광고",
          "output": "테레비 광고",
          "named_dict_tsv": "[brand]\nexact\tko-KR\tTV\t테레비\n"
        },
        {
          "syntax": "[[…]]{@exact:이름}",
          "meaning": "{@dictionary:이름}과 같음",
          "example": "[[TV]]{@exact:brand.tsv} 광고",
          "output": "테레비 광고",
          "named_dict_tsv": "[brand]\nexact\tko-KR\tTV\t테레비\n"
        },
        {
          "syntax": "[[…]]{@nodict}",
          "meaning": "구간에 사전을 하나도 쓰지 않음 (시스템·사용자·요청 사전 모두)",
          "example": "[[TV]]{@nodict} 화면",
          "output": "티브이 화면"
        }
      ]
    },
    {
      "group": "끊어 읽기",
      "rows": [
        {
          "syntax": "원자{@break:1}",
          "meaning": "한 글자씩, 공백으로",
          "example": "1234{@break:1}",
          "output": "일 이 삼 사"
        },
        {
          "syntax": "원자{@break:2}",
          "meaning": "한 글자씩, 쉼표로",
          "example": "1234{@break:2}",
          "output": "일, 이, 삼, 사"
        },
        {
          "syntax": "원자{@break:3}",
          "meaning": "한 글자씩, 마침표로",
          "example": "1234{@break:3}",
          "output": "일. 이. 삼. 사."
        },
        {
          "syntax": "문장 안에서",
          "meaning": "앞뒤 문장은 그대로",
          "example": "번호는 1234{@break:2}입니다.",
          "output": "번호는 일, 이, 삼, 사입니다."
        },
        {
          "syntax": "[[구간]]{@join}",
          "meaning": "break의 반대: 평소처럼 읽고 띄어쓰기를 없애 붙임",
          "example": "[[너 나 안 본 지 두 달 다 되 감]]{@join}",
          "output": "너나안본지두달다되감"
        },
        {
          "syntax": "숫자도 읽은 뒤 붙임",
          "meaning": "앞뒤 문장은 그대로",
          "example": "오늘 [[3시 반에 만나]]{@join} 알겠지?",
          "output": "오늘 세시반에만나 알겠지?"
        },
        {
          "syntax": "[[구간]]{@pronounce}",
          "meaning": "평소처럼 읽은 뒤 한국어를 발음대로 씀 (구어, 한글 발음열)",
          "example": "오늘 [[민주주의의 의의]]{@pronounce}를 배웠다.",
          "output": "오늘 민주주이으 으이를 배웠다."
        },
        {
          "syntax": "원자{@pronounce}",
          "meaning": "원자 하나를 문장 문맥대로 읽은 뒤 발음대로 씀",
          "example": "112{@pronounce}에 신고해주세요.",
          "output": "일릴리에 신고해주세요."
        }
      ]
    },
    {
      "group": "이스케이프",
      "rows": [
        {
          "syntax": "\\{ \\} \\[ \\] \\\\",
          "meaning": "제어 문자 자체를 글자로 쓰기",
          "example": "\\{첫\\}",
          "output": "{첫}"
        }
      ]
    }
  ],
  "options": [
    {
      "id": "language",
      "key": "default_language",
      "desc": "문장 언어를 가릴 단서가 없을 때 쓰는 언어(숫자만 있는 문장 등). '문장 언어: 기본 언어로 고정'이면 모든 문장에 적용됩니다.",
      "examples": [
        {
          "text": "7 7 7",
          "outputs": {
            "ko-KR": "칠 칠 칠",
            "en-US": "seven seven seven",
            "zh-CN": "七 七 七",
            "vi-VN": "bảy bảy bảy",
            "th-TH": "เจ็ด เจ็ด เจ็ด",
            "ar": "سبعة سبعة سبعة"
          }
        }
      ]
    },
    {
      "id": "policy",
      "key": "render_policy",
      "desc": "다른 언어 단어를 그 문장 언어의 발음으로 바꿀지 정합니다.",
      "examples": [
        {
          "text": "Apple은 사과입니다.",
          "outputs": {
            "phonetic": "애플은 사과입니다.",
            "preserve": "Apple은 사과입니다."
          }
        }
      ]
    },
    {
      "id": "domain",
      "key": "domain",
      "desc": "업무 도메인 발음사전을 더합니다. 금융 발음사전은 시스템 사전에 없는 금융 약어 읽기를 더합니다.",
      "examples": [
        {
          "text": "isa 계좌",
          "outputs": {
            "none": "이사 계좌",
            "finance-vocabulary": "아이에스에이 계좌"
          }
        }
      ]
    },
    {
      "id": "input-format",
      "key": "input_format",
      "desc": "{…}·[[…]] 발음 제어 표기를 해석할지 정합니다. 문법은 입력창 아래 '제어 구문 도움말'에 있습니다.",
      "examples": [
        {
          "text": "1{첫}번째",
          "outputs": {
            "plain": "일{첫}번째",
            "annotated": "첫번째"
          }
        }
      ]
    },
    {
      "id": "output-mode",
      "key": "output_mode",
      "desc": "발화용은 이메일·URL·기호까지 소리 나는 말로 바꾸고, 표기 보존은 주소·기호 표기를 남깁니다.",
      "examples": [
        {
          "text": "a1@b2.com 3시",
          "outputs": {
            "speech": "에이일 앳 비이 닷 컴 세 시",
            "text": "a1@b2.com 세 시"
          }
        }
      ]
    },
    {
      "id": "symbols",
      "key": "symbols",
      "desc": "기호·이모지와 읽을 수 없는 문자를 한 번에 정합니다. 값마다 아래 세부 설정 세 개(읽을 수 없는 문자, 장식 문자, 기호·이모지 이름)를 함께 바꾸며, 세부 설정을 따로 바꾸면 '세부 설정 조합'으로 표시됩니다.",
      "presets": {
        "name-keep": {
          "symbol_fallback": "on",
          "decorative": "follow",
          "unreadable": "preserve"
        },
        "name-drop": {
          "symbol_fallback": "on",
          "decorative": "follow",
          "unreadable": "drop"
        },
        "all-names": {
          "symbol_fallback": "on",
          "decorative": "read",
          "unreadable": "preserve"
        },
        "off": {
          "symbol_fallback": "off",
          "decorative": "follow",
          "unreadable": "preserve"
        }
      },
      "examples": [
        {
          "text": "★ 신메뉴 🍔 ∢ 가⸮나 ※ 참고",
          "outputs": {
            "name-keep": "★ 신메뉴 햄버거 스퍼리컬 앵글 가⸮나 ※ 참고",
            "name-drop": "신메뉴 햄버거 스퍼리컬 앵글 가 나 참고",
            "all-names": "별 신메뉴 햄버거 스퍼리컬 앵글 가⸮나 참고표 참고",
            "off": "★ 신메뉴 🍔 ∢ 가⸮나 ※ 참고"
          }
        }
      ]
    },
    {
      "id": "unreadable",
      "key": "unreadable",
      "desc": "읽을 방법이 없는 문자(이름도 없는 문자)와 해석을 거부한 표기 중 숫자 폴백이 읽지 않는 것(25:00 같은 시각 모양)의 처리입니다. 발화용 출력에서만 적용됩니다.",
      "examples": [
        {
          "text": "가⸮나",
          "outputs": {
            "preserve": "가⸮나",
            "drop": "가 나",
            "read": "가 나"
          }
        },
        {
          "text": "25:00 정각",
          "outputs": {
            "preserve": "25:00 정각",
            "drop": "25:00 정각",
            "read": "이오:영영 정각"
          }
        }
      ]
    },
    {
      "id": "brackets",
      "key": "brackets",
      "desc": "괄호 속 보충 설명을 읽을지 정합니다.",
      "examples": [
        {
          "text": "가격(10%) 인상",
          "outputs": {
            "read": "가격(십 퍼센트) 인상",
            "skip": "가격 인상",
            "preserve": "가격(10%) 인상"
          }
        }
      ]
    },
    {
      "id": "unknown-foreign",
      "key": "unknown_foreign",
      "desc": "발음사전에 없는 영문 단어를 어떻게 읽을지 정합니다.",
      "examples": [
        {
          "text": "Zorblax는 새 앱",
          "outputs": {
            "guess": "조블랙스는 새 앱",
            "spell": "제트오알비엘에이엑스는 새 앱",
            "preserve": "Zorblax는 새 앱"
          }
        }
      ]
    },
    {
      "id": "decorative",
      "key": "decorative",
      "desc": "★ ※ ♥ → 같은 장식 문자입니다. '따름'이면 '읽을 수 없는 문자' 정책을 따릅니다.",
      "examples": [
        {
          "text": "★ 별점 ※ 참고",
          "outputs": {
            "follow": "★ 별점 ※ 참고",
            "read": "별 별점 참고표 참고"
          }
        }
      ]
    },
    {
      "id": "initialism",
      "key": "initialism",
      "desc": "대문자 두 글자 이상을 약어로 볼지 단어로 볼지 정합니다. 사전에 등록된 약어(NASA 등)는 어느 쪽이든 사전 발음입니다.",
      "examples": [
        {
          "text": "IT 기업",
          "outputs": {
            "spell": "아이티 기업",
            "word": "잇 기업"
          }
        }
      ]
    },
    {
      "id": "spacing",
      "key": "spacing",
      "desc": "한국어 수 읽기의 띄어쓰기입니다. 맞춤법은 만 단위로, 읽기 단위는 단위·숫자마다 띄웁니다.",
      "examples": [
        {
          "text": "12345원",
          "outputs": {
            "orthographic": "만 이천삼백사십오 원",
            "reading-unit": "만 이천 삼백 사십 오 원"
          }
        }
      ]
    },
    {
      "id": "matrix",
      "key": "matrix",
      "desc": "문장마다 언어를 판정합니다. 영어 문장 속 한글 단어는 그대로 두고 영어로 읽습니다.",
      "examples": [
        {
          "text": "My friend 민수 bought 12 books.",
          "outputs": {
            "auto": "My friend 민수 bought twelve books.",
            "declared": "마이 프린드 민수 바우그흐트 십이 북스."
          }
        }
      ]
    },
    {
      "id": "foreign-sentence",
      "key": "foreign_sentence",
      "desc": "한국어 요청에서 영어로 판정된 문장을 영어 대신 한글로 읽습니다. 숫자·날짜·통화는 영어 규칙으로 먼저 읽고(3 three, 1st first, 2019 twenty nineteen) 그 읽기를 외래어 발음으로 옮깁니다. 한글 단위나 조사가 붙은 숫자(3명, 3시에)는 한국어로 읽습니다. 영어 발음 사전이 자동이면 함께 켜집니다.",
      "examples": [
        {
